{
  "name": "agent-wtf",
  "version": "0.1.0",
  "description": "Your coding agent says it's done. WTF checks.",
  "type": "module",
  "bin": {
    "wtf": "./bin/wtf.js",
    "agent-wtf": "./bin/wtf.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE",
    "AGENTS.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LinusInnovator/wtf.git"
  },
  "homepage": "https://github.com/LinusInnovator/wtf#readme",
  "bugs": {
    "url": "https://github.com/LinusInnovator/wtf/issues"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist/cli.js && esbuild src/core/evidence-compiler.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist/evidence-compiler.js",
    "prepublishOnly": "npm run build && npm test",
    "test": "vitest run test",
    "test:watch": "vitest test",
    "gauntlet": "vitest run test/gauntlet.test.ts",
    "typecheck": "tsc --noEmit",
    "demo": "bash scripts/demo.sh"
  },
  "keywords": [
    "git",
    "cli",
    "developer-tools",
    "ai-agents",
    "code-review",
    "verification",
    "claude-code",
    "cursor",
    "copilot",
    "diff"
  ],
  "author": "WTF Contributors",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
